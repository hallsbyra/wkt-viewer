{
  "name": "wkt-viewer",
  "displayName": "WKT Viewer",
  "description": "A VS Code extension to visualize and navigate files containing WKT (Well Known Text) geometries.",
  "keywords": [
    "vscode",
    "extension",
    "wkt",
    "viewer",
    "geometry",
    "visualization"
  ],
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/hallsbyra/wkt-viewer"
  },
  "version": "0.5.0",
  "publisher": "halls-byra",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension/dist/extension.js",
  "workspaces": [
    "shared",
    "extension",
    "webview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "wktViewer.start",
        "title": "Start WKT Viewer"
      }
    ],
    "configuration": {
      "title": "WKT Viewer",
      "properties": {
        "wktViewer.maxGeometries": {
          "type": "integer",
          "default": 500,
          "minimum": 1,
          "markdownDescription": "Maximum number of WKT geometries to parse and show from the active document."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build --workspaces && npm run lint",
    "clean": "npm run clean --workspaces",
    "lint": "eslint",
    "vscode:prepublish": "npm run clean && npm run build",
    "watch": "tsc --build --watch",
    "package": "vsce package",
    "test": "npm run test:extension && npm run test:webview",
    "test:extension": "npm run build -w extension && vscode-test --fail-zero",
    "test:webview": "npm run test -w webview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/mocha": "^10.0.10",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.10.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0"
  },
  "overrides": {
    "mocha": {
      "diff": "^8.0.3",
      "serialize-javascript": "^7.0.5"
    }
  }
}
