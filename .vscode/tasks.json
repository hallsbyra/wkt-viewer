// See https://go.microsoft.com/fwlink/?LinkId=733558
// for the documentation about the tasks.json format
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "TS Watch",
			"type": "shell",
			"command": "npm run watch",
			"isBackground": true,
			"problemMatcher": "$tsc-watch",
		},
		{
			"label": "Vite Dev",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"options": {
				"cwd": "webview"
			},
			"problemMatcher": {
				"pattern": { "regexp": ".*" },
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE v.*",
					"endsPattern": ".*Local:.*"
				}
			}
		},
		{
			"label": "Start Dev Host",
			"type": "process",
			"command": "node",
			"args": [
				"${workspaceFolder}/scripts/start-dev-host.mjs",
				"${execPath}"
			],
			"options": { "cwd": "${workspaceFolder}" },
			"dependsOn": "Start Dev Env",
			"problemMatcher": []
		},
		{
			"label": "Start Dev Env",
			"dependsOn": [
				"TS Watch",
				"Vite Dev",
			],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	]
}
